rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && me().role == "admin"; }
    function isHR() { return signedIn() && me().role in ["admin", "hr"]; }
    function isManager() { return signedIn() && me().role == "manager"; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == "pending";
      allow update: if isAdmin()
        || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lang","theme","lastLogin","displayName","photoURL"]));
      allow delete: if false;
    }

    // Job title library (departments, titles, level overrides). Everyone signed in reads it; only Admin edits it.
    match /departments/{code} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /employees/{id} {
      allow read: if isHR() || (isManager() && resource.data.departmentId == me().departmentId);
      allow create: if isHR()
        || (isManager()
            && request.resource.data.departmentId == me().departmentId
            && request.resource.data.get("evaluation", null) == null
            && request.resource.data.status in ["draft", "submitted"]);
      allow update: if isAdmin()
        // HR: everything except giving the final approval (that is the department manager's step)
        || (isHR()
            && (request.resource.data.status != "approved"
                || (resource.data.status == "approved"
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["evaluation", "managerApproval"]))))
        // Manager: edit own department's profile while draft / returned (sections 1–11 only)
        || (isManager()
            && resource.data.departmentId == me().departmentId
            && request.resource.data.departmentId == me().departmentId
            && resource.data.status in ["draft", "returned"]
            && request.resource.data.status in ["draft", "submitted"]
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["evaluation", "managerApproval"]))
        // Manager: approve the HR-proposed grade, or return it to HR
        || (isManager()
            && resource.data.departmentId == me().departmentId
            && resource.data.status == "manager_approval"
            && request.resource.data.status in ["approved", "under_evaluation"]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "position", "managerApproval", "updatedAt", "updatedBy"])
            && request.resource.data.position.diff(resource.data.position).affectedKeys().hasOnly(["currentGrade", "lastEvaluationDate"])
            && request.resource.data.managerApproval.byUid == request.auth.uid
            && (request.resource.data.status != "approved"
                || request.resource.data.position.currentGrade == resource.data.evaluation.finalGrade));
      allow delete: if isAdmin();
    }
  }
}
