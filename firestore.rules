rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function myRole() { return me().role; }
    function isAdmin() { return signedIn() && myRole() == "admin"; }
    function isStaffHR() { return signedIn() && myRole() in ["admin", "hr_director", "hr"]; }   // evaluators + director
    function isDirector() { return signedIn() && myRole() in ["admin", "hr_director"]; }       // final approval
    function isManager() { return signedIn() && myRole() == "manager"; }
    function isActive() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && myRole() != "pending"; }
    function myEmail() { return request.auth.token.get("email", ""); }
    // Conflict of interest: the employee on the record is not the person acting
    function notSelf(data) { return data.get("employeeEmail", "") == "" || data.get("employeeEmail", "") != myEmail(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // A position's fixed standard must be an exact copy of the current HR template (or absent)
    function stdOk() {
      return request.resource.data.get("standard", null) == null
        || request.resource.data.standard.items == get(/databases/$(db)/documents/jobTemplates/$(request.resource.data.standard.templateId)).data.fixedItems;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == "pending";
      allow update: if isAdmin()
        || (request.auth.uid == uid && changed().hasOnly(["lang", "theme", "lastLogin", "displayName", "photoURL"]));
      allow delete: if false;
    }

    // Routing directory for e-mail notifications (name, role, department, Outlook address). Maintained by Admin.
    match /directory/{uid} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Outgoing e-mail queue, processed by the "Trigger Email from Firestore" extension (Microsoft 365 SMTP).
    // Only fixed templates, only to addresses that are in the directory.
    match /mail/{id} {
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(["to", "toUid", "template", "createdAt", "createdBy", "positionDocId"])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.template.keys().hasOnly(["name", "data"])
        && request.resource.data.template.name in ["evaluation_request", "evaluation_returned", "approval_request", "approved", "approval_returned", "profile_request"]
        && request.resource.data.to == get(/databases/$(db)/documents/directory/$(request.resource.data.toUid)).data.notifyEmail;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /mailTemplates/{name} {
      allow read, write: if isAdmin();
    }

    // Job description templates per title = the fixed job standard. Maintained by HR / Admin only.
    match /jobTemplates/{id} {
      allow read: if isActive();
      allow write: if isStaffHR();
    }

    // Employee database, loaded from the HR Excel file. Managers read their own department.
    match /people/{code} {
      allow read: if isStaffHR() || (isManager() && resource.data.departmentId == me().departmentId);
      allow write: if isStaffHR();
    }

    // Full salary table (settings/salaryBands): HR, HR Director and Admin read and change it
    match /settings/{id} {
      allow read, write: if isStaffHR();
    }
    // Per-department copy of the salary table: a manager reads only their own department
    match /salaryByDept/{dept} {
      allow read: if isStaffHR() || (isManager() && me().departmentId == dept);
      allow write: if isStaffHR();
    }

    // Job title library. Everyone signed in reads it; only Admin edits it.
    match /departments/{code} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /employees/{id} {
      allow read: if isStaffHR() || (isManager() && resource.data.departmentId == me().departmentId);

      allow create: if isAdmin()
        // HR may open a draft for a department (the manager then scores and submits)
        || (isStaffHR()
            && request.resource.data.status == "draft"
            && request.resource.data.get("evaluation", null) == null
            && request.resource.data.get("managerEvaluation", null) == null
            && request.resource.data.get("finalApproval", null) == null)
        // Manager: own department, step 1 only
        || (isManager()
            && request.resource.data.departmentId == me().departmentId
            && request.resource.data.get("evaluation", null) == null
            && request.resource.data.get("finalApproval", null) == null
            && request.resource.data.status in ["draft", "submitted"]
            && request.resource.data.get("personalGrade", null) == null
            && stdOk()
            && notSelf(request.resource.data));

      allow update: if isAdmin()
        // HR evaluator / director: profile + HR evaluation. Never the manager's scores, never the final approval.
        || (isStaffHR()
            && !changed().hasAny(["managerEvaluation", "finalApproval", "managerApproval"])
            && (request.resource.data.status in ["draft", "submitted", "under_evaluation", "returned", "director_approval"]
                || (resource.data.status == "approved" && request.resource.data.status == "approved" && !changed().hasAny(["evaluation"])))
            && (!changed().hasAny(["evaluation"])
                || (notSelf(resource.data) && request.resource.data.evaluation.evaluatorUid == request.auth.uid)))
        // Manager: own department, while draft / returned; may write own scores (not for own position)
        || (isManager()
            && resource.data.departmentId == me().departmentId
            && request.resource.data.departmentId == me().departmentId
            && resource.data.status in ["draft", "returned"]
            && request.resource.data.status in ["draft", "submitted"]
            && !changed().hasAny(["evaluation", "finalApproval", "managerApproval", "personalGrade"])
            && (!changed().hasAny(["standard"]) || stdOk())
            && (!changed().hasAny(["managerEvaluation"]) || notSelf(resource.data)))
        // Manager: update the job description (sections 1–11) at any later status — no scores, status, grade or employee changes
        || (isManager()
            && resource.data.departmentId == me().departmentId
            && request.resource.data.departmentId == me().departmentId
            && request.resource.data.status == resource.data.status
            && !changed().hasAny(["evaluation", "finalApproval", "managerApproval", "managerEvaluation", "status", "employeeEmail", "employeeCode", "fullName", "returnComment", "personalGrade"])
            && (!changed().hasAny(["standard"]) || stdOk())
            && request.resource.data.position.get("currentGrade", "") == resource.data.position.get("currentGrade", ""))
        // HR Director / HR Manager: final approval or return to HR (four-eyes + conflict of interest)
        || (isDirector()
            && resource.data.status in ["director_approval", "manager_approval"]
            && request.resource.data.status in ["approved", "under_evaluation"]
            && changed().hasOnly(["status", "position", "finalApproval", "history", "updatedAt", "updatedBy"])
            && request.resource.data.position.diff(resource.data.position).affectedKeys().hasOnly(["currentGrade", "lastEvaluationDate"])
            && request.resource.data.finalApproval.byUid == request.auth.uid
            && resource.data.evaluation.get("evaluatorUid", "") != request.auth.uid
            && notSelf(resource.data)
            && (request.resource.data.status != "approved"
                || request.resource.data.position.currentGrade == resource.data.evaluation.finalGrade));

      allow delete: if isAdmin();
    }
  }
}
